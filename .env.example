# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# 시간당 랭킹 채널 (Discord Developer Mode에서 채널 ID 복사)
# 0으로 설정하면 자동 랭킹 비활성화
RANKING_CHANNEL_ID=0

# Admin Password (Dashboard - 선택)
ADMIN_PASSWORD=your_secure_password_here
FLASK_SECRET_KEY=your-random-secret-key-here

# Flask 서버 설정
# macOS AirPlay Receiver가 5000번 포트를 사용하므로 5001번 포트 사용
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Flask 생명주기 자동 관리 (권장: systemd 사용 시 False)
MANAGE_FLASK_LIFECYCLE=False

# Database
DB_PATH=data/bot.db

# Optional: Debug Mode
DEBUG_MODE=False

# Optional: Flask 서버 모니터링 채널 (Discord Developer Mode에서 채널 ID 복사)
# 0으로 설정하면 모니터링 비활성화
MONITORING_CHANNEL_ID=0
